  Command-line build for the IoT SAFE applet. Compiles, converts and verifies
  the CAP without needing Eclipse or the Oracle Java Card plug-in.

  Requires the Oracle Java Card Development Kit, which is not redistributable
  and so is not vendored here. Point JC_HOME at your installation:

      export JC_HOME=/path/to/java_card_devkit-3_1_0
      ant

  Build orchestration uses ant-javacard, which abstracts over the differences
  between Java Card SDK versions. The 'bootstrap' target fetches it.
-->
<project name="iot-safe-applet" default="cap" basedir=".">

  <property environment="env"/>

  <!-- Java Card Development Kit location: -DJC_HOME=... overrides $JC_HOME. -->
  <condition property="jc.home" value="${JC_HOME}" else="${env.JC_HOME}">
    <isset property="JC_HOME"/>
  </condition>

  <property name="src.dir"        value="src"/>
  <property name="out.dir"        value="deliverables/IoTSafeApplet"/>
  <property name="tools.dir"      value="tools"/>
  <property name="antjc.jar"      value="${tools.dir}/ant-javacard.jar"/>
  <property name="antjc.version"  value="21.03.13"/>
  <property name="antjc.url"
            value="https://github.com/martinpaljak/ant-javacard/releases/download/v${antjc.version}/ant-javacard.jar"/>

  <!-- AIDs. Change both before any production deployment: the RID
       A0:00:00:00:62 belongs to Oracle and is reserved for Java Card samples. -->
  <property name="package.aid" value="A00000006203010C01"/>
  <property name="applet.aid"  value="A00000006203010C0101"/>
  <property name="package.version" value="1.0"/>

  <!-- ===================================================================== -->

  <target name="check-jc-home">
    <fail message="JC_HOME is not set.&#10;Set it to your Oracle Java Card Development Kit, e.g.&#10;  export JC_HOME=/opt/java_card_devkit-3_1_0&#10;or pass -DJC_HOME=/path/to/sdk to ant.">
      <condition>
        <or>
          <not><isset property="jc.home"/></not>
          <equals arg1="${jc.home}" arg2=""/>
        </or>
      </condition>
    </fail>
    <fail message="JC_HOME=${jc.home} does not look like a Java Card SDK (no lib/ directory).">
      <condition>
        <not><available file="${jc.home}/lib" type="dir"/></not>
      </condition>
    </fail>
    <echo message="Using Java Card SDK at ${jc.home}"/>
  </target>

  <target name="bootstrap" description="Download the ant-javacard build task">
    <mkdir dir="${tools.dir}"/>
    <get src="${antjc.url}" dest="${antjc.jar}" skipexisting="true" verbose="true"/>
  </target>

  <target name="-taskdef" depends="bootstrap">
    <taskdef name="javacard"
             classname="pro.javacard.ant.JavaCard"
             classpath="${antjc.jar}"/>
  </target>

  <target name="cap" depends="check-jc-home,-taskdef"
          description="Compile, convert and verify the applet CAP (default)">
    <mkdir dir="${out.dir}"/>
    <javacard jckit="${jc.home}">
      <cap targetsdk="${jc.home}"
           aid="${package.aid}"
           package="com.consec.iotsafe"
           version="${package.version}"
           output="${out.dir}/IoTSafeApplet.cap"
           export="${out.dir}"
           jca="${out.dir}/IoTSafeApplet.jca"
           sources="${src.dir}"
           debug="false"
           verify="true">
        <applet class="com.consec.iotsafe.IoTSafeApplet" aid="${applet.aid}"/>
      </cap>
    </javacard>
    <echo message="CAP written to ${out.dir}/IoTSafeApplet.cap"/>
  </target>

  <target name="clean" description="Remove build output">
    <delete dir="${out.dir}"/>
    <delete dir="bin"/>
    <delete dir=".gen"/>
  </target>

  <target name="distclean" depends="clean"
          description="Remove build output and downloaded build tools">
    <delete dir="${tools.dir}"/>
  </target>

</project>
